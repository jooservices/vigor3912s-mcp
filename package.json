{
  "name": "@jooservices/vigor3912s-mcp",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run lint && npm run test:coverage && npm run build",
    "e2e": "node tools/e2e.mjs",
    "e2e:testing": "node tools/e2e_testing_run.mjs"
  },
  "dependencies": {
    "@jooservices/ssh-client": "file:../ssh-client",
    "@jooservices/vigor3912s-sdk": "file:../vigor3912s-sdk",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "dotenv": "^16.4.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.6",
    "@vitest/coverage-v8": "^5.0.0",
    "ssh2": "^1.16.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true,
    "esbuild@0.28.2": true
  }
}
