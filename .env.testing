# Testing environment for `npm run e2e:testing`.
# Brought up by tools/e2e_testing_run.mjs against the simulated DrayOS server.
# Safe default for local configuration; the testing wrapper explicitly enables
# all tools only after starting the simulated DrayOS server.
VIGOR_HOST=127.0.0.1
VIGOR_PORT=22
VIGOR_USER=admin
VIGOR_PASSWORD=fake-admin
VIGOR_LOG_DB=data/e2e-testing.db
EXPOSE_TOOLS=readonly
# The testing wrapper enables this only for the simulated DrayOS server.
VIGOR_AUTO_COMMIT=true
# Simulated DrayOS host keys are ephemeral — skip pin in CI/local e2e:testing only.
VIGOR_SSH_INSECURE_SKIP_VERIFY=true
