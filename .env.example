# Vigor3912S MCP server configuration (copy to .env, chmod 600)
# WARNING: never commit .env. Password is stored plaintext in this local file.
VIGOR_HOST=192.168.1.1
VIGOR_PORT=22
VIGOR_USER=admin
VIGOR_PASSWORD=change_me
# SQLite log database (optional; default: data/vigor3912s.db)
# VIGOR_LOG_DB=data/vigor3912s.db

# Safety switches (optional)
# Read-only: write tools are NOT registered (monitoring only)
# VIGOR_READ_ONLY=true
# Auto-run `sys commit` after a confirmed write (default true)
# VIGOR_AUTO_COMMIT=true
# Human-in-the-loop confirm for every write (default false):
#   true  -> write tools hide the confirm token; the human must approve in chat
#            ("are you sure") AND provide the confirmation code below.
#   false -> write tools return the confirm token (AI can confirm).
# VIGOR_HUMAN_CONFIRM=false
# The confirmation code the human types to approve a write (required when
# VIGOR_HUMAN_CONFIRM=true; min 8 chars). Keep it secret; model cannot read it.
# VIGOR_CONFIRM_PASSPHRASE=change-me-strong-code
# EXPOSE_TOOLS: whitelist of tools exposed to the AI.
#   'readonly' -> only read tools; 'all' (or empty) -> every tool;
#   otherwise comma-separated tool ids, e.g. wan_status,show_status
# Local (real router) should use: readonly
# GHA (fake DrayOS server) uses: all
# EXPOSE_TOOLS=readonly
# Never-register list (comma-separated tool ids)
# VIGOR_DISABLED_TOOLS=
# Max chars a read tool returns before truncation (0 = unlimited)
# VIGOR_TOOL_OUTPUT_LIMIT=16000